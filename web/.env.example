# Set these in Vercel → Project → Settings → Environment Variables. Never commit real values.
GOOGLE_SERVICE_ACCOUNT_JSON=   # the whole service-account .json file, pasted as one value
HITLIST_SHEET_ID=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SESSION_SECRET=                # long random string (signs sign-in sessions)
WORKER_SECRET=                 # same value as WORKER_SECRET in the mini PC's .env
# Blob: connect a PRIVATE Blob store to the project; Vercel adds its variables automatically.
